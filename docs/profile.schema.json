{
  "title": "Who Am I profile (profileVersion 1)",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "whoami.profile"
    },
    "profileVersion": {
      "type": "number",
      "const": 1
    },
    "contentVersion": {
      "type": "string"
    },
    "appVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "sensitiveIncluded": {
          "type": "boolean"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Topics with at least one answer that are included"
        }
      },
      "required": [
        "sensitiveIncluded",
        "topics"
      ],
      "additionalProperties": false
    },
    "axes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "-1..1 between the two poles; null = not enough data"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "description": "Total evidence weight behind the score"
          },
          "spread": {
            "type": "number",
            "minimum": 0,
            "description": "Weighted standard deviation of the evidence"
          },
          "topics": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of topics contributing"
          },
          "family": {
            "type": "string",
            "enum": [
              "political",
              "personality",
              "values",
              "thinking",
              "worldview",
              "taste"
            ]
          }
        },
        "required": [
          "score",
          "confidence",
          "weight",
          "spread",
          "topics",
          "family"
        ],
        "additionalProperties": false
      }
    },
    "principles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "-1..1 between the two poles; null = not enough data"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "description": "Total evidence weight behind the score"
          },
          "spread": {
            "type": "number",
            "minimum": 0,
            "description": "Weighted standard deviation of the evidence"
          },
          "topics": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of topics contributing"
          },
          "byTopic": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            },
            "description": "Endorsement of the principle within each topic"
          },
          "consistency": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "1 = applied the same way across topics (anchor items only); null with fewer than 2 topics"
          }
        },
        "required": [
          "score",
          "confidence",
          "weight",
          "spread",
          "topics",
          "byTopic",
          "consistency"
        ],
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "stance": {
            "type": [
              "number",
              "null"
            ]
          },
          "stanceLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "initialStance": {
            "type": [
              "number",
              "null"
            ]
          },
          "importance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "circumstances": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "challenges": {
            "type": "object",
            "properties": {
              "asked": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "held": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "distinguished": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "moved": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "moves": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "description": "Challenge or re-ask item that prompted the change"
                    },
                    "delta": {
                      "type": "number",
                      "description": "Change in normalized value (-2..2)"
                    },
                    "steps": {
                      "description": "Change in scale steps, for scale items",
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "delta",
                    "steps"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "asked",
              "held",
              "distinguished",
              "moved",
              "moves"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "stance",
          "stanceLabel",
          "initialStance",
          "importance",
          "complete",
          "circumstances",
          "challenges"
        ],
        "additionalProperties": false
      }
    },
    "interests": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "\"topic.item.option\" (multi-select pick) or \"topic.item\" (interest rating) → 0..1 intensity"
    },
    "identity": {
      "description": "Self-reported, opt-in; present only when sensitive answers are included",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "principle": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "gap": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "distinguished",
              "revised",
              "acknowledged"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "principle",
          "topics",
          "gap",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "validated",
          "adapted",
          "custom",
          "for-fun"
        ]
      }
    },
    "completeness": {
      "type": "object",
      "properties": {
        "answered": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Items with a value-bearing answer"
        },
        "orphaned": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Stored answers that no longer match current content"
        }
      },
      "required": [
        "answered",
        "orphaned"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "profileVersion",
    "contentVersion",
    "appVersion",
    "generatedAt",
    "scope",
    "axes",
    "principles",
    "topics",
    "interests",
    "tensions",
    "evidence",
    "completeness"
  ],
  "additionalProperties": false
}

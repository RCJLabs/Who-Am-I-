{
  "title": "Who Am I topic file",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "core",
        "extended"
      ]
    },
    "evidence": {
      "type": "string",
      "enum": [
        "validated",
        "adapted",
        "custom",
        "for-fun"
      ],
      "description": "validated instrument, adapted from research, custom, or for fun"
    },
    "source": {
      "description": "Instrument or source citation",
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "description": "Shown once before the first item",
      "type": "string",
      "minLength": 1
    },
    "sensitive": {
      "type": "boolean"
    },
    "stance": {
      "description": "Item holding the overall position; challenges are checked against it",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "importance": {
      "description": "Importance item; low importance skips deep items",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "The question or statement shown to the user"
              },
              "help": {
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "description": "Free tags, e.g. circumstance",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "when": {
                "description": "Show only when this condition is true, e.g. \"stance < 0 and rape > 0\". Refs must be earlier items.",
                "type": "string",
                "minLength": 1
              },
              "deep": {
                "description": "Skipped when the user says the topic matters little to them",
                "type": "boolean"
              },
              "sticky": {
                "description": "Keep scoring the answer even if the item later becomes hidden (default: true for challenges)",
                "type": "boolean"
              },
              "unsure": {
                "description": "Offer \"No opinion / not sure\" (default true)",
                "type": "boolean"
              },
              "sensitive": {
                "description": "Adds \"Prefer not to say\"; inherited from the topic",
                "type": "boolean"
              },
              "axes": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "number"
                },
                "description": "On scale items: weights (sign = which way agreeing pushes). On options: positions in [-1, 1]. A target that is not listed means \"no information\"."
              },
              "principles": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "number"
                },
                "description": "On scale items: weights (sign = which way agreeing pushes). On options: positions in [-1, 1]. A target that is not listed means \"no information\"."
              },
              "anchor": {
                "type": "object",
                "properties": {
                  "principle": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "description": "The single principle this item probes"
                  },
                  "context": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Short phrase naming the context, e.g. \"continuing a pregnancy\""
                  },
                  "against": {
                    "description": "The competing interest in this context, used to suggest a relevant difference on tension cards",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "principle",
                  "context"
                ],
                "additionalProperties": false,
                "description": "Marks a matched-wording probe of one principle; the only items the tension detector compares"
              },
              "type": {
                "type": "string",
                "const": "likert"
              },
              "points": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 5
                  },
                  {
                    "type": "number",
                    "const": 7
                  }
                ]
              },
              "labels": {
                "description": "agree (default), accuracy (IPIP), or explicit labels",
                "anyOf": [
                  {
                    "type": "string",
                    "const": "agree"
                  },
                  {
                    "type": "string",
                    "const": "accuracy"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "text",
              "type",
              "points"
            ],
            "additionalProperties": false
          },
